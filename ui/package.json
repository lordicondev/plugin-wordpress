{
    "name": "plugin-wordpress",
    "private": true,
    "version": "1.0.0",
    "author": "Lordicon <dev@lordicon.com>",
    "license": "UNLICENSED",
    "description": "Lordicon WordPress plugin - editor, settings and front-end bundles",
    "type": "module",
    "scripts": {
        "start": "npm run dev",
        "build:block": "vite build --config vite-block.config.ts",
        "build:element": "vite build --config vite-element.config.ts",
        "build:settings": "vite build --config vite-settings.config.ts",
        "build": "npm run clean && npm run build:block && npm run build:element && npm run build:settings",
        "dev:block": "vite build --config vite-block.config.ts --watch",
        "dev:element": "vite build --config vite-element.config.ts --watch",
        "dev:settings": "vite build --config vite-settings.config.ts --watch",
        "dev": "concurrently -n block,element,settings \"npm run dev:block\" \"npm run dev:element\" \"npm run dev:settings\"",
        "clean": "node -e \"fs.rmSync('../dist',{recursive:true,force:true})\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tools/baseline/tsconfig.json",
        "baseline:serve": "vite --config tools/baseline/vite.config.ts",
        "baseline:capture": "node tools/driver/render-report.mjs",
        "package": "npm run build && node tools/package.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@lit/task": "^1.0.3",
        "@lordicon/element": "^2.3.1",
        "@lordicon/internal": "^0.5.0",
        "@lordicon/utils-lottie": "^1.3.0",
        "@lordicon/utils-svg": "^1.2.0",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^24.13.3",
        "concurrently": "^9.2.4",
        "eslint": "^10.9.1",
        "fs-extra": "^11.4.0",
        "globals": "^17.12.0",
        "inversify": "^7.11.0",
        "lit": "^3.3.3",
        "puppeteer-core": "^25.9.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.69.0",
        "vite": "^7.3.6"
    }
}
